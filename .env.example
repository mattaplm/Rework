# Postgres (local dev: the `postgres` service in docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rework
POSTGRES_USER=rework
POSTGRES_PASSWORD=change-me

# SyteLine SQL Server (ERP) -- leave blank to run with reference-data sync disabled
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
# {SQL Server} ships with Windows already and needs no admin rights to install,
# unlike "ODBC Driver 17/18 for SQL Server" -- only change this if that's
# actually installed on your machine.
SQL_DRIVER={SQL Server}

# Flask
SECRET_KEY=change-me
ADMIN_DEFAULT_PASSWORD=
